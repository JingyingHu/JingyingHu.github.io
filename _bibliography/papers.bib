  publisher    = {Association for Computational Linguistics},
  doi          = {10.18653/v1/2025.cmcl-1.22},
  abstract     = {This study explores how LLM can inform language assessment for second language (L2) learners. Specifically, we examine LLM-derived surprisal as a scalable and interpretable metric for modeling Chinese L2 writing development, demonstrating its potential as a cross-linguistically robust measure for automatic writing assessment.},
