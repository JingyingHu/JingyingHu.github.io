  title        = {Where Does the Relative Clause Attach? Probing Prosodic and Semantic Sensitivity in Large Audio Language Models},
  author       = {Hu, Jingying and Issa, Elsayed},
  booktitle    = {Conference on Language Modeling},
  year         = {2026},
  abstract         = {We test whether large audio language models use prosodic and semantic cues to resolve relative-clause attachment ambiguities in English, Chinese, and Arabic. Models show limited sensitivity to prosody but greater reliance on semantic and world-knowledge cues.},
