  title        = {Modeling Chinese L2 Writing Development: The LLM-Surprisal Perspective},
  author       = {Hu, Jingying and Cong, Yan},
  booktitle    = {Proceedings of the Workshop on Cognitive Modeling and Computational Linguistics},
  year         = {2025},
  pages        = {172--183},
